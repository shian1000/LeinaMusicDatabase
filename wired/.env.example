# REQUIRED: the exact addresses to listen on, separated by spaces. Nothing else is opened.
# 0.0.0.0 means every address, and only when you write it here.
WIRED_ADDRESSES=
# The port (default 8002)
WIRED_PORT=
# Names the server is reached by, separated by spaces, besides its IP addresses and localhost.
# A request naming anything else is refused, so a web page can't reach it through a browser.
WIRED_SERVER_NAMES=
# Add-ons to load, separated by spaces. "sync" = syncing users' data and serving the catalog. Off by default.
WIRED_ADDONS=
# Where the data goes (default: data/ here)
WIRED_DATA_DIR=
# off = plain HTTP, only for trying it out on this machine
WIRED_TLS=
# Add-on "sync": the GitHub repository whose "database" release holds the catalog
WIRED_CATALOG_REPO=
# Add-on "sync": off = download the catalog only when asked
WIRED_CATALOG_UPDATES=
