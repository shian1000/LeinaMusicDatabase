# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put real credentials, addresses or paths in this example file.
# See AGENTS.md -> Secrets and "Machine settings". The folders and the LAN interface can also be set
# from the app: Settings -> Server -> Folders and network.

# Credentials for an smb:// MUSIC_LIBRARY_DIR (src/settings.py adds them to the URI).
SMB_USERNAME=
SMB_PASSWORD=

# Optional: a YouTube Data API v3 *API key* (Google Cloud console -> APIs &
# Services -> Credentials -> Create credentials -> API key). Read-only public
# data: "Resolve new requests" uses it to check whether videos still exist
# without hitting yt-dlp's bot wall. Doesn't expire, unlike the OAuth token.
YOUTUBE_API_KEY=

# The mp3 collection: a local folder, or smb://host/share/path/ (no credentials). Empty = no library to index or serve.
MUSIC_LIBRARY_DIR=/path/to/Music/Library/
# Mount point of the external drive holding SHARING_DIR; nothing is written there while it isn't mounted.
SHARING_DRIVE_MOUNT=/path/to/data-drive
# Folder (on that drive) the sharing server serves to Leina Radio; holds Users/, Inbox/ and MoodChanges/. Empty = no sharing or users.
SHARING_DIR=/path/to/data-drive/Shared/Music/Database
# Optional: network interface the sharing server also listens on for the home LAN (e.g. enp2s0). Empty = Tailscale only.
SHARING_LAN_INTERFACE=

# MusicDatabase-Remote.sh (run the app on the server from another computer over ssh; a user@host argument overrides these):
# the server's user@LAN address, used while connected to the Wi-Fi named REMOTE_HOME_SSID,
REMOTE_LAN=user@192.0.2.10
# the server's user@Tailscale address, used everywhere else,
REMOTE_TAILSCALE=user@100.64.0.10
# the home Wi-Fi's name (empty = always Tailscale),
REMOTE_HOME_SSID=
# and the checkout's folder on the server (default ~/Documents/Code/MusicDatabase).
REMOTE_REPO_DIR=
