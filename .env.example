# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put real credentials in this example file.
#
# Used by src/settings.py to build the smb:// URI for the local music library
# share. See AGENTS.md -> Secrets.

SMB_USERNAME=
SMB_PASSWORD=

# Optional: a YouTube Data API v3 *API key* (Google Cloud console -> APIs &
# Services -> Credentials -> Create credentials -> API key). Read-only public
# data: "Resolve new requests" uses it to check whether videos still exist
# without hitting yt-dlp's bot wall. Doesn't expire, unlike the OAuth token.
YOUTUBE_API_KEY=
