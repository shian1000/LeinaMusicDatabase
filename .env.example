# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put real credentials, addresses or paths in this example file.
# See AGENTS.md -> Secrets and "Machine settings". The folders and the LAN interface can also be set
# from the app: Settings -> Server -> Folders and network.

# Credentials for an smb:// MUSIC_LIBRARY_DIR (src/settings.py adds them to the URI).
SMB_USERNAME=
SMB_PASSWORD=

# Optional: a YouTube Data API v3 *API key* (Google Cloud console -> APIs &
# Services -> Credentials -> Create credentials -> API key). Read-only public
# data: "Resolve new requests" uses it to check whether videos still exist
# without hitting yt-dlp's bot wall. Doesn't expire, unlike the OAuth token.
YOUTUBE_API_KEY=

# The mp3 collection: a local folder, or smb://host/share/path/ (no credentials). Empty = no library to index or serve.
MUSIC_LIBRARY_DIR=/path/to/Music/Library/
# Folder the sharing server serves to Leina Radio; holds Users/, Inbox/ and MoodChanges/. Empty = no sharing or users.
# On the system disk (SHARING_DRIVE_MOUNT empty) it must exist - the in-app setting offers to create it.
SHARING_DIR=/path/to/MusicDatabase-Shared
# Only when SHARING_DIR is on an external drive: its mount point. Nothing is written there while it isn't
# mounted (so nothing lands on the system disk under the empty mount point). Empty = no external drive.
SHARING_DRIVE_MOUNT=
# Optional: network interface the sharing server also listens on for the home LAN (e.g. enp2s0). Empty = Tailscale only.
SHARING_LAN_INTERFACE=
# Whether the server also listens on this PC's Tailscale address, when it has one: on / off (empty = on).
SHARING_TAILSCALE=
# Optional: other exact IPv4 addresses of this PC to listen on, comma-separated (e.g. another VPN's address).
# 0.0.0.0 = every network this PC is on - only if you really want that. The server needs at least one address
# (Tailscale's, the LAN interface's or one of these) that a phone can reach.
SHARING_ADDRESSES=

# Start-up tasks (Settings -> Start-up tasks): empty = on, "off" = skipped. The daily backup, applying phones'
# global mood changes, the daily library index, the daily copy for phones, the daily yt-dlp update offer and
# the start-up messages. (The daily GitHub publish has its own switch in Settings -> Server -> Public database.)
STARTUP_BACKUP=
STARTUP_MOOD_CHANGES=
STARTUP_LIBRARY_INDEX=
STARTUP_SHARE_COPY=
STARTUP_YTDLP_UPDATE=
STARTUP_MESSAGES=

# MusicDatabase-Remote.sh (run the app on the server from another computer over ssh; a user@host argument overrides these):
# the server's user@LAN address, used while connected to the Wi-Fi named REMOTE_HOME_SSID,
REMOTE_LAN=user@192.0.2.10
# the server's user@Tailscale address, used everywhere else,
REMOTE_TAILSCALE=user@100.64.0.10
# the home Wi-Fi's name (empty = always Tailscale),
REMOTE_HOME_SSID=
# and the checkout's folder on the server (default ~/Documents/Code/MusicDatabase).
REMOTE_REPO_DIR=

# The public copy of music.db / tag.db as a GitHub Release, for Leina Radio phones without the sharing server
# (Settings -> Server -> Public database on GitHub, which also shows how to make the token):
# the repository as owner/repo (empty = not publishing; a fresh install without databases then downloads
# the project's own public catalog, from shian1000/LeinaMusicDatabase),
GITHUB_DB_REPO=
# and a fine-grained token with Contents: read and write on that repository only. Never commit it.
GITHUB_DB_TOKEN=
